<?xml version="1.0" encoding="utf-8"?> 
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="..\Directory.Build.targets" />

  <Target Name="_CompileCppWinRTOutputs" AfterTargets="CppWinRTMakeProjections">
    <ItemGroup>
      <ClCompile Include="$(GeneratedFilesDir)module.g.cpp" />

      <ClCompile Update="@(ClCompile)">
        <AdditionalIncludeDirectories>$(GeneratedFilesDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      </ClCompile>
    </ItemGroup>
  </Target>
</Project>
