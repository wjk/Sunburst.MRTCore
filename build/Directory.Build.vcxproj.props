<Project>
  <PropertyGroup>
    <OutDir>$(BaseOutputPath)$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(BaseIntermediateOutputPath)$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  
  <ItemGroup>
    <ProjectCapability Include="PackageReferences" />
  </ItemGroup>

  <PropertyGroup>
    <ResolveNuGetPackages>false</ResolveNuGetPackages>
    <TargetFrameworkMoniker>native,Version=0.0</TargetFrameworkMoniker>
    <NuGetTargetMoniker>native,Version=0.0</NuGetTargetMoniker>
  </PropertyGroup>

  <Import Project="$(MSBuildProjectExtensionsPath)$(MSBuildProjectFile).*.props"
          Condition="Exists('$(MSBuildProjectExtensionsPath)$(MSBuildProjectFile).*.props')" />
</Project>
