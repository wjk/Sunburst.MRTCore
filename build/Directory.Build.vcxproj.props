<Project>
  <PropertyGroup>
    <OutDir>$(BaseOutputPath)$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(BaseIntermediateOutputPath)$(Platform)\$(Configuration)\</IntDir>
    <OutDirWasSet>true</OutDirWasSet>
  </PropertyGroup>

  <PropertyGroup>
    <EnableNativePackageReferenceSupport>true</EnableNativePackageReferenceSupport>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
